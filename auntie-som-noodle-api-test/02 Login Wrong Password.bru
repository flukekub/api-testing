meta {
  name: 02 Login Wrong Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "student",
    "password": "not-hungry"
  }
}

tests {
  test("returns 401", () => expect(res.status).to.equal(401));
  test("does not return a token", () => expect(res.body.accessToken).to.be.undefined);
}
