meta {
  name: 05 Order Invalid Token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: this-is-not-a-real-token
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

tests {
  test("returns 401 with an invalid token", () => expect(res.status).to.equal(401));
}
