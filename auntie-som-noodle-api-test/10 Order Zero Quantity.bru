meta {
  name: 10 Order Zero Quantity
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "itemId": 1,
    "quantity": 0
  }
}

tests {
  test("rejects quantity 0 with 400", () => expect(res.status).to.equal(400));
  test("does not create an order", () => expect(res.body.orderId).to.be.undefined);
}
