meta {
  name: 11 Order Negative Quantity
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "itemId": 1,
    "quantity": -3
  }
}

tests {
  test("rejects negative quantity with 400", () => expect(res.status).to.equal(400));
  test("does not create an order", () => expect(res.body.orderId).to.be.undefined);
}
